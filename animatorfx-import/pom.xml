<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.dlsc.animatorfx</groupId>
        <artifactId>animatorfx-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>animatorfx-import</artifactId>
    <name>AnimatorFX Import</name>

    <properties>
        <maven.compiler.release>${editor.java.release}</maven.compiler.release>
        <surefire.jvm.args>${javafx.headless.jvm.args}</surefire.jvm.args>
    </properties>

    <!-- Pins every (also transitive) JavaFX artifact to the editor JavaFX version. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-base</artifactId>
                <version>${javafx.editor.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-graphics</artifactId>
                <version>${javafx.editor.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-controls</artifactId>
                <version>${javafx.editor.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-fxml</artifactId>
                <version>${javafx.editor.version}</version>
            </dependency>
            <!-- required by the AnimatorFX player (sound) -->
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-media</artifactId>
                <version>${javafx.editor.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>com.dlsc.animatorfx</groupId>
            <artifactId>animatorfx-model</artifactId>
        </dependency>
        <!-- The typed model of the Lottie format and its reader; LottieImporter converts from it. -->
        <dependency>
            <groupId>com.lottie4j</groupId>
            <artifactId>core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dlsc.animatorfx</groupId>
            <artifactId>animatorfx-player</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Renders the same Lottie file as the reference; no production code depends on it. -->
        <dependency>
            <groupId>com.lottie4j</groupId>
            <artifactId>fxplayer</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>testfx-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>openjfx-monocle</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
