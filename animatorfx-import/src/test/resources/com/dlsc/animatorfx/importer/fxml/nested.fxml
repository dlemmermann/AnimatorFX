<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.shape.Rectangle?>

<Pane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:id="root">
    <Rectangle fx:id="back" x="10" y="10" width="100" height="60" fill="navy"/>
    <Group fx:id="card" layoutX="40" layoutY="20">
        <Rectangle fx:id="cardBody" width="80" height="50" fill="white"/>
        <Rectangle fx:id="cardBadge" x="60" y="-5" width="30" height="15" fill="crimson"/>
    </Group>
    <Rectangle fx:id="front" x="150" y="100" width="20" height="20" fill="gold"/>
</Pane>
